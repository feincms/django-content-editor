#: admin.py:288
msgid "Add new item"
msgstr "Neues Element hinzufügen"

#: admin.py:289
msgid "No items."
msgstr "Keine Elemente."

#: admin.py:290
msgid "No items. Region may inherit content."
msgstr "Keine Elemente. Region könnte Inhalt erben."

#: admin.py:291
msgid "No regions available."
msgstr "Keine Regionen verfügbar."

#: admin.py:292
msgid "No plugins allowed in this region."
msgstr "Keine der Elemente sind in dieser Region erlaubt."

#: admin.py:293
msgid "New item"
msgstr "Neues Element"

#: admin.py:294
msgid "Unknown region"
msgstr "Unbekannte Region"

#: admin.py:295
msgid "Collapse all items"
msgstr "Alle Elemente ausblenden"

#: admin.py:296
msgid "Uncollapse all items"
msgstr "Alle Elemente einblenden"

#: admin.py:297
msgid "marked for deletion"
msgstr "zur Löschung markiert"

#: admin.py:299
msgid "Use Ctrl-Click to select and move multiple items."
msgstr ""
"Mit Ctrl-Click können mehrere Elemente ausgewählt und verschoben werden."

#: admin.py:301
msgid "Clone from region"
msgstr "Von Region klonen"

#: admin.py:302
msgid "Didn't find anything to clone"
msgstr "Konnte nichts finden zum Klonen"

#: admin.py:303
msgid "Select all"
msgstr "Alle auswählen"

#: admin.py:305
msgid ""
"This container isn't empty. Which items should be marked for deletion? They "
"will be deleted when saving."
msgstr ""
"Dieser Container ist nicht leer. Welche Elemente sollen zur Löschung markiert "
"werden? Sie werden beim Speichern gelöscht."

#: admin.py:308
msgid "Container and contents"
msgstr "Container und Inhalt"

#: admin.py:309
msgid "Only the container"
msgstr "Nur den Container"

#: admin.py:310
msgid "Indent (Alt+Shift+Right)"
msgstr "Einrücken (Alt+Umschalt+Rechts)"

#: admin.py:311
msgid "Outdent (Alt+Shift+Left)"
msgstr "Ausrücken (Alt+Umschalt+Links)"

#: admin.py:355
#, python-brace-format
msgid "Cloning {} plugins succeeded."
msgstr "{} Elemente erfolgreich geklont."

#: admin.py:360
#, python-brace-format
msgid "Cloning plugins failed: {}"
msgstr "Fehler beim klonen: {}"

#~ msgid "Toggle sidebar"
#~ msgstr "Sidebar ein-/ausblenden"

#~ msgid "Doubleclicking inserts an item at the end."
#~ msgstr "Ein Doppelklick fügt ein Element am Ende hinzu."
